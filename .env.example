# Explicit server-side configuration only; no API key or URL is accepted from the browser.
# The application reads process environment. This file is a template, not auto-loaded.
# Default runtime_mode=offline makes no external calls. configured requires all three services.
# URLs are complete endpoints: HTTPS, or HTTP on literal loopback/localhost only.
# Fill in approved provider values privately. Nothing below authorizes a network call.
RAG_EMBEDDING_URL=
RAG_EMBEDDING_MODEL=
# Set a fixed model/algorithm revision; changing it invalidates the embedding cache.
RAG_EMBEDDING_REVISION=
RAG_EMBEDDING_API_KEY=
# Exact returned model name; omit when identical to the requested model.
# RAG_EMBEDDING_RESPONSE_MODEL=
RAG_EMBEDDING_DIMENSIONS=1024
# Enable only when this model supports the dimensions request parameter.
RAG_EMBEDDING_SEND_DIMENSIONS=false

RAG_CHAT_URL=
RAG_CHAT_MODEL=
RAG_CHAT_API_KEY=
# RAG_CHAT_RESPONSE_MODEL=
# Local text-only Qwen3.5 example after conversion/startup (no key needed):
# RAG_CHAT_URL=http://127.0.0.1:5101/v1/chat/completions
# RAG_CHAT_MODEL=qwen3.5-9b-mlx-4bit
# .venv-mlx/bin/python scripts/local_model/serve_mlx.py --port 5101

# DashScope native text-rerank endpoint; OpenAI-compatible chat/embedding above.
RAG_RERANK_URL=
RAG_RERANK_MODEL=
RAG_RERANK_API_KEY=

RAG_MODEL_TIMEOUT_SECONDS=60
RAG_MODEL_MAX_OUTPUT_TOKENS=2048
# No price table is configured: monetary cost stays unknown (null), never an invented zero.
